/* RESET */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* BODY */

body {
  font-family: 'Poppins', sans-serif;
  background-color: #f4ffe9;
  color: #1f2937;
}

/* IMAGES */

img {
  max-width: 100%;
  height: auto;
}

/* HEADER */

header {

  background: white;

  padding: 15px 8%;

  display: flex;

  justify-content: space-between;

  align-items: center;

  border-bottom: 1px solid #d1fae5;

  position: relative;
}

/* LOGO */

.logo {
  width: 65px;
}

/* NAVIGATION */

nav {

  display: flex;
}

nav a {

  text-decoration: none;

  color: #1f2937;

  margin-left: 20px;

  font-size: 14px;
}

nav a:hover {
  color: #155E55;
}

nav a.active {

  color: #8EEA4A;

  border-bottom: 2px solid #155E55;
}

/* HAMBURGER */

.menu-toggle {

  display: none;

  flex-direction: column;

  cursor: pointer;
}

.menu-toggle span {

  width: 25px;

  height: 3px;

  background: #155E55;

  margin: 4px 0;
}

/* HERO */

.hero {

  background-image: url("../assets/images/hero.webp");

  background-size: cover;

  background-position: center;

  background-repeat: no-repeat;

  min-height: 500px;

  display: flex;

  align-items: center;

  padding: 100px 8%;
}

.hero-container {

  display: flex;

  align-items: center;

  justify-content: space-between;

  width: 100%;
}

.hero-text {

  max-width: 500px;
}

.hero-text h2 {

  font-size: 42px;

  margin-bottom: 20px;

  color: #155E55;
}

.hero span {

  color: #8EEA4A;
}

.hero-text p {

  font-size: 18px;

  margin-bottom: 30px;
}

/* BUTTON */

.btn {

  display: inline-block;

  padding: 12px 25px;

  background: #155E55;

  color: white;

  text-decoration: none;

  border-radius: 6px;

  font-weight: 600;
}

/* SECTIONS */

.section {

  padding: 70px 8%;

  text-align: center;
}

/* CARDS */

.cards {

  display: grid;

  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));

  gap: 25px;

  margin-top: 40px;
}

.card {

  background: white;

  padding: 30px;

  border-radius: 12px;

  border: 1px solid #d1fae5;
}

/* FOOTER */

footer {

  background: #155E55;

  color: white;

  text-align: center;

  padding: 20px;

  margin-top: 40px;
}

/* MOBILE */

@media (max-width: 768px) {

/* SHOW HAMBURGER */

.menu-toggle {

  display: flex;
}

/* MOBILE NAV */

nav {

  position: absolute;

  top: 70px;

  right: 0;

  background: white;

  width: 100%;

  flex-direction: column;

  align-items: center;

  display: none;

  padding: 20px 0;
}

nav.active {

  display: flex;
}

nav a {

  margin: 10px 0;

  font-size: 16px;
}

/* HERO MOBILE */

.hero {

  padding: 80px 20px;

  min-height: 400px;
}

.hero-container {

  flex-direction: column;

  text-align: center;
}

.hero-text h2 {

  font-size: 28px;
}

}

